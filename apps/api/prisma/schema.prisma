generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ChinaHsCode {
  hsCode8               String             @id @map("hs_code_8") @db.VarChar(8)
  hsCode                String?            @map("hs_code") @db.VarChar(13)
  hsCode10              String?            @map("hs_code_10") @db.VarChar(10)
  chapter               String             @db.VarChar(2)
  section               String?            @db.VarChar(5)
  descriptionEn         String             @map("description_en")
  descriptionZh         String             @map("description_zh")
  mfnDutyRate           Decimal?           @map("mfn_duty_rate") @db.Decimal(6, 2)
  vatRate               Decimal?           @map("vat_rate") @db.Decimal(6, 2)
  requiresLicence       Boolean            @default(false) @map("requires_licence")
  ciqInspection         Boolean            @default(false) @map("ciq_inspection")
  isRestricted          Boolean            @default(false) @map("is_restricted")
  isProhibited          Boolean            @default(false) @map("is_prohibited")
  supervisoryConditions String?            @map("supervisory_conditions")
  ciqCodes              String?            @map("ciq_codes")
  dataSource            String?            @map("data_source")
  lastUpdated           DateTime           @default(now()) @map("last_updated")
  mappings              BilateralMapping[]

  @@map("hs_codes_china")
}

model IndiaHsCode {
  hsCode             String             @id @map("hs_code") @db.VarChar(8)
  chapter            String             @db.VarChar(2)
  section            String?            @db.VarChar(5)
  descriptionEn      String             @map("description_en")
  descriptionHi      String?            @map("description_hi")
  bcdRate            Decimal?           @map("bcd_rate") @db.Decimal(6, 2)
  igstRate           Decimal?           @map("igst_rate") @db.Decimal(6, 2)
  swsRate            Decimal            @default(10) @map("sws_rate") @db.Decimal(6, 2)
  importPolicy       String?            @map("import_policy")
  requiresLicence    Boolean            @default(false) @map("requires_licence")
  requiresInspection Boolean            @default(false) @map("requires_inspection")
  inspectionAgency   String?            @map("inspection_agency")
  isRestricted       Boolean            @default(false) @map("is_restricted")
  isProhibited       Boolean            @default(false) @map("is_prohibited")
  dataSource         String?            @map("data_source")
  lastUpdated        DateTime           @default(now()) @map("last_updated")
  mappings           BilateralMapping[]

  @@map("hs_codes_india")
}

model BilateralMapping {
  id              Int         @id @default(autoincrement())
  chinaHsCode8    String      @map("china_hs_code_8")
  indiaHsCode     String      @map("india_hs_code")
  matchConfidence Decimal     @map("match_confidence") @db.Decimal(4, 3)
  matchMethod     String      @map("match_method")
  china           ChinaHsCode @relation(fields: [chinaHsCode8], references: [hsCode8])
  india           IndiaHsCode @relation(fields: [indiaHsCode], references: [hsCode])

  @@unique([chinaHsCode8, indiaHsCode])
  @@map("bilateral_mappings")
}

model Synonym {
  id        Int    @id @default(autoincrement())
  term      String @unique
  canonical String

  @@map("synonyms")
}

model ExchangeRate {
  id            Int      @id @default(autoincrement())
  fromCurrency  String   @map("from_currency") @db.VarChar(3)
  toCurrency    String   @map("to_currency") @db.VarChar(3)
  rate          Decimal  @db.Decimal(12, 4)
  effectiveDate DateTime @map("effective_date") @db.Date
  source        String?
  updatedBy     String?  @map("updated_by")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([fromCurrency, toCurrency])
  @@map("exchange_rates")
}

model SearchLog {
  id          Int      @id @default(autoincrement())
  query       String
  country     String
  resultCount Int      @map("result_count")
  language    String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("search_logs")
}

model AiClassification {
  id                 Int      @id @default(autoincrement())
  productDescription String   @map("product_description")
  language           String?
  country            String
  results            Json?
  createdAt          DateTime @default(now()) @map("created_at")

  @@map("ai_classifications")
}

model ErrorLog {
  id        Int      @id @default(autoincrement())
  route     String?
  message   String
  stack     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("error_logs")
}
